---
import PaperAuthors from "./PaperAuthors.astro";
import PaperLinks from "./PaperLinks.astro";

interface PaperLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  authors: (string | { name: string; url: string })[];
  note?: string;
  venue: string;
  description: string;
  links: PaperLink[];
  href: string; // the write-up page
}

const { title, authors, note, venue, description, links, href } = Astro.props;
---

<article class="paper">
  <p class="paper-venue">{venue}</p>
  <h3 class="paper-title"><a href={href}>{title}</a></h3>
  <PaperAuthors authors={authors} note={note} />
  <p class="paper-description">{description}</p>
  <PaperLinks links={links} writeup={href} />
</article>

<style scoped>
  .paper {
    border: rgb(230, 230, 230) 1px solid;
    border-radius: 16px;
    padding: 1rem 1.25rem;
  }

  .paper-venue {
    font-family: var(--mono-font);
    font-size: 0.9rem;
    color: #555;
    margin: 0;
  }

  .paper-title {
    font-size: 1.4rem;
    line-height: 1.3;
    margin: 0.4rem 0 0.5rem 0;
  }
  .paper-title a {
    color: inherit;
    transition: color 0.2s ease-in-out;
  }
  .paper-title a:hover {
    color: var(--active-color);
  }

  .paper-description {
    font-size: 1.1rem;
    line-height: 1.5;
    margin: 0.5rem 0 0.9rem 0;
  }
</style>
