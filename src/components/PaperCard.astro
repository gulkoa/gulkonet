---
import PaperAuthors from "./PaperAuthors.astro";
import PaperLinks from "./PaperLinks.astro";

interface PaperLink {
  label: string;
  href: string;
}

interface Props {
  title: string;
  authors: (string | { name: string; url: string })[];
  advisors?: (string | { name: string; url: string })[];
  note?: string;
  venue: string;
  description: string;
  links: PaperLink[];
  href: string; // the write-up page
}

const { title, authors, advisors, note, venue, description, links, href } = Astro.props;
---

<article class="paper">
  <p class="paper-venue">{venue}</p>
  <h3 class="paper-title"><a href={href}>{title}</a></h3>
  <PaperAuthors authors={authors} advisors={advisors} note={note} />
  <p class="paper-description">{description}</p>
  <PaperLinks links={links} writeup={href} />
</article>

<style scoped>
  .paper {
    position: relative;
    border: rgb(230, 230, 230) 1px solid;
    border-radius: 16px;
    padding: 1rem 1.25rem;
  }

  /* Hovering the title turns the top right corner over, like the corner of a page.
     The square sits on the card's corner: the half above the diagonal is the page showing
     through where the corner was, the half below it is the back of the folded corner. */
  .paper::after {
    content: "";
    position: absolute;
    top: -1px;
    right: -1px;
    width: 30px;
    height: 30px;
    background: linear-gradient(to top right, rgb(232, 234, 239) 0%, rgb(250, 250, 252) 48%, rgb(214, 216, 222) 49%, rgb(214, 216, 222) 51%, white 52%);
    border-left: rgb(218, 220, 226) 1px solid;
    border-bottom: rgb(218, 220, 226) 1px solid;
    border-bottom-left-radius: 12px;
    box-shadow: -2px 2px 5px -1px rgba(0, 0, 0, 0.16);
    transform: scale(0);
    transform-origin: top right;
    transition: transform 0.25s ease;
    pointer-events: none;
  }
  .paper:has(.paper-title a:hover)::after,
  .paper:has(.paper-title a:focus-visible)::after {
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .paper::after {
      transition: none;
    }
  }

  .paper-venue {
    font-family: var(--mono-font);
    font-size: 0.9rem;
    color: #555;
    margin: 0;
  }

  .paper-title {
    font-size: 1.4rem;
    line-height: 1.3;
    margin: 0.4rem 0 0.5rem 0;
  }
  .paper-title a {
    color: inherit;
    transition: color 0.2s ease-in-out;
  }
  .paper-title a:hover {
    color: var(--active-color);
  }

  .paper-description {
    font-size: 1.1rem;
    line-height: 1.5;
    margin: 0.5rem 0 0.9rem 0;
  }
</style>
