---
import { Github, AlignJustify, Rss } from 'lucide-astro';
const year = new Date().getFullYear();
---

<footer>
  <div class="left part">
    <p>MIT License © {year} Alex Gulko</p>
  </div>
  <div class="right part">

    <a href="/rss.xml" title="RSS feed">
      <Rss height="15"/>
      RSS
    </a>

    <a href="https://github.com/GulkoA/gulkonet">
      <Github height="15"/>
      Source code
    </a>

    <a href="/credits">
      <AlignJustify height="15"/>
      Open source credits
    </a>
  </div>
</footer>

<style scoped>
  footer {
    height: fit-content;
    margin: 0;
    padding: 1.25rem 0;

    background-color: #fafafa;
    border-top: 1px solid #ececec;
    color: #777;
    font-family: var(--mono-font);
    font-size: 12px;
    font-weight: 100;

    display: flex;
    flex-direction: row;
    justify-content: space-between;
    vertical-align: baseline;
    align-items: center;
    gap: 0.5rem;
  }

  @media (max-width: 800px) {
    footer {
      flex-direction: column-reverse;
      gap: 0.75rem;
    }
  }

  footer > .part {
    display: flex;
    align-items: center;
    vertical-align: middle;
    padding: 0 10px;
    gap: 1rem;
  }

  a {
    color: #777;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.2rem;
    transition: color 0.2s ease;
  }
  a:hover {
    color: #111;
  }


  p {
    margin: 0;
    font-size: 12px;
  }
</style>