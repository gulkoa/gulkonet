---
import { Github, AlignJustify, Rss } from 'lucide-astro';
const year = new Date().getFullYear();
---

<footer>
  <div class="inner">
    <div class="left part">
      <p class="name">Alex Gulko</p>
      <p class="license">MIT License © {year}</p>
    </div>
    <div class="right part">

      <a href="/rss.xml" title="RSS feed">
        <Rss height="15"/>
        RSS
      </a>

      <a href="https://github.com/GulkoA/gulkonet">
        <Github height="15"/>
        Source code
      </a>

      <a href="/credits">
        <AlignJustify height="15"/>
        Open source credits
      </a>
    </div>
  </div>
</footer>

<style scoped>
  footer {
    margin: 0;
    background-color: var(--ink);
    color: #b9bac4;
    font-family: var(--mono-font);
    font-size: 13px;
  }

  .inner {
    padding: 2rem var(--content-margin);

    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  @media (max-width: 800px) {
    .inner {
      flex-direction: column-reverse;
      align-items: flex-start;
      gap: 1.5rem;
    }
  }

  footer .part {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .left.part {
    flex-direction: column;
    align-items: flex-start;
    gap: 0.25rem;
  }

  .name {
    font-family: var(--general-font);
    font-size: 1.1rem;
    font-weight: 500;
    color: white;
  }

  a {
    color: #b9bac4;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 0.3rem;
    transition: color 0.2s ease;
  }
  a:hover {
    color: white;
  }

  p {
    margin: 0;
  }
</style>
