---
import Diagram from "./Diagram.astro";
---

<Diagram
  viewBox="0 0 1000 190"
  label="Byte layout of a .litl file, using a real 47,378 byte example: 4 bytes of magic spelling LITL, 1 byte format version, a 4 byte checksum, a 4 byte metadata length (99 here), then 99 bytes of zstd-compressed JSON metadata and the zstd-compressed blob in the remaining 47,266 bytes. The checksum covers the metadata and the blob."
>
  <!-- what the checksum protects -->
  <path d="M245,68 V30 H984 V44" class="dg-line-muted"></path>
  <path d="M414,30 V44" class="dg-line-muted"></path>
  <text x="699" y="16" class="dg-sub">the checksum covers these bytes</text>

  <!-- byte offsets -->
  <text x="16" y="58" class="dg-mono dg-start" font-size="11.5">0</text>
  <text x="118" y="58" class="dg-mono dg-start" font-size="11.5">4</text>
  <text x="190" y="58" class="dg-mono dg-start" font-size="11.5">5</text>
  <text x="302" y="58" class="dg-mono dg-start" font-size="11.5">9</text>
  <text x="418" y="58" class="dg-mono dg-start" font-size="11.5">13</text>
  <text x="670" y="58" class="dg-mono dg-start" font-size="11.5">112</text>

  <!-- the file, left to right -->
  <rect x="16" y="70" width="100" height="50" rx="6" class="dg-soft"></rect>
  <text x="66" y="95" class="dg-mono" font-size="15">LITL</text>
  <rect x="118" y="70" width="70" height="50" rx="6" class="dg-soft"></rect>
  <text x="153" y="95" class="dg-mono" font-size="15">1</text>
  <rect x="190" y="70" width="110" height="50" rx="6" class="dg-soft"></rect>
  <text x="245" y="95" class="dg-mono" font-size="15">f1 35 b4 c1</text>
  <rect x="302" y="70" width="110" height="50" rx="6" class="dg-soft"></rect>
  <text x="357" y="95" class="dg-mono" font-size="15">99</text>
  <rect x="414" y="70" width="250" height="50" rx="6" class="dg-accent"></rect>
  <text x="539" y="95" class="dg-title">metadata</text>
  <rect x="666" y="70" width="318" height="50" rx="6" class="dg-solid"></rect>
  <text x="825" y="95" class="dg-title dg-on-solid">compressed blob</text>

  <!-- what each part is -->
  <text x="66" y="140" class="dg-sub">magic</text>
  <text x="66" y="157" class="dg-sub">4 bytes</text>
  <text x="153" y="140" class="dg-sub">version</text>
  <text x="153" y="157" class="dg-sub">1 byte</text>
  <text x="245" y="140" class="dg-sub">checksum</text>
  <text x="245" y="157" class="dg-sub">4 bytes</text>
  <text x="357" y="140" class="dg-sub">metadata size</text>
  <text x="357" y="157" class="dg-sub">4 bytes</text>
  <text x="539" y="140" class="dg-sub">JSON, zstd · 99 bytes</text>
  <text x="539" y="157" class="dg-sub">litl version, compressor, its metadata</text>
  <text x="825" y="140" class="dg-sub">zstd · the remaining 47,266 bytes</text>
  <text x="825" y="157" class="dg-sub">whatever your compressor returned</text>

  <!-- the caption the page passes in goes on to the figure -->
  <slot name="caption" slot="caption" />
</Diagram>
