---
// Shared frame for the hand-drawn SVG diagrams: sizing, arrowheads and caption. The `dg-*` classes live in diagram.css.
import "./diagram.css";

// Usage: <Diagram viewBox="0 0 1000 400" label="what the picture shows" caption="..."> ...svg shapes... </Diagram>
// A component that wraps Diagram passes its own caption slot on with <slot name="caption" slot="caption" />.
interface Props {
  viewBox: string;
  label: string; // read by screen readers instead of the drawing
  caption?: string;
  minWidth?: number; // below this width the figure scrolls sideways instead of shrinking the text
  maxWidth?: number;
}

const { viewBox, label, caption, minWidth = 680, maxWidth } = Astro.props;

// The diagram components forward their caption slot here whether or not the page filled it,
// so look at what the slot renders to before adding a figcaption.
const slottedCaption = Astro.slots.has("caption") ? (await Astro.slots.render("caption")).trim() : "";
---

<figure class="diagram">
  <div class="diagram-scroll">
    <svg
      viewBox={viewBox}
      role="img"
      aria-label={label}
      xmlns="http://www.w3.org/2000/svg"
      style={`min-width: ${minWidth}px;` + (maxWidth ? ` max-width: ${maxWidth}px;` : "")}
    >
      <defs>
        <marker id="dg-arrow" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,1 L9,5 L0,9 z" class="dg-arrowhead"></path>
        </marker>
        <marker id="dg-arrow-muted" viewBox="0 0 10 10" refX="8.5" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
          <path d="M0,1 L9,5 L0,9 z" class="dg-arrowhead-muted"></path>
        </marker>
      </defs>
      <slot />
    </svg>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
  {slottedCaption && <figcaption set:html={slottedCaption} />}
</figure>
