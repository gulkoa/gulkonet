---
type Author = string | { name: string; url: string };

interface Props {
  authors: Author[];
  note?: string;
}

const { note } = Astro.props;
const authors = Astro.props.authors.map((author) => (typeof author === "string" ? { name: author, url: undefined } : author));

// the site owner is highlighted in the author list (a trailing * marks equal contribution)
const me = "Alex Gulko";
const isMe = (author: string) => author.replace(/\*$/, "") === me;
---

<p class="paper-authors">
  {authors.map((author, i) => (
    <Fragment>{isMe(author.name) ? <strong>{author.name}</strong> : author.url ? <a href={author.url}>{author.name}</a> : author.name}{i < authors.length - 1 ? ", " : ""}</Fragment>
  ))}
  {note && <span class="paper-note"> · {note}</span>}
</p>

<style scoped>
  .paper-authors {
    font-size: 1.1rem;
    margin: 0;
  }
  .paper-authors strong {
    font-weight: 700;
  }
  .paper-note {
    color: #555;
  }
</style>
