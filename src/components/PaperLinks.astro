---
import { FileText, Github, Database, BookOpen } from "lucide-astro";

interface PaperLink {
  label: string;
  href: string;
}

interface Props {
  links: PaperLink[];
  writeup?: string; // internal link to the write-up page, shown first as the filled pill
}

const { links, writeup } = Astro.props;

const icon = (href: string) => {
  if (/^https?:\/\/(www\.)?github\.com\//.test(href)) return Github;
  if (/^https?:\/\/huggingface\.co\/datasets\//.test(href)) return Database;
  return FileText;
};
---

<div class="paper-links" data-pagefind-ignore>
  {writeup && (
    <a class="paper-link primary" href={writeup}>
      <BookOpen size="18" />
      Write-up
    </a>
  )}
  {links.map((link) => {
    const Icon = icon(link.href);
    return (
      <a class="paper-link" href={link.href}>
        <Icon size="18" />
        {link.label}
      </a>
    );
  })}
</div>

<style scoped>
  .paper-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .paper-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.8rem;
    border: 2px solid var(--active-color);
    border-radius: 20px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--active-color);
    background-color: white;
    transition: all 0.2s ease-in-out;
  }
  .paper-link.primary,
  .paper-link:hover {
    color: white;
    background-color: var(--active-color);
  }
  .paper-link.primary:hover {
    box-shadow: var(--active-color-transparent) 0px 0px 0px 0.2rem;
  }
  .paper-link:active {
    box-shadow: var(--active-color-transparent) 0px 0px 0px 0.3rem;
  }
</style>
