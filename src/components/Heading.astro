---
const {title, titleClass, subtitle, backgroundColor, secondaryColor} = Astro.props;
---

<header class="heading unmargin" style={backgroundColor ? `background-color: ${backgroundColor}` : undefined}>
  <div class="heading-left">
    <slot name="left"/>
  </div>
  <div class="heading-right">
    <h1 style={{color: secondaryColor}} class={titleClass || ""}>{title}</h1>
    <span style={{color: secondaryColor}}>{subtitle}</span>
    <slot name="right" />
  </div>
</header>

<style>
  .heading {
    /* sizing */
    margin-bottom: 2rem;
    min-height: 500px;
    padding: 4rem 0 2rem;
    box-sizing: border-box;
    border-bottom: 1px solid var(--line);

    /* nesting */
    display: flex;
    justify-content: center;
    flex-direction: row;
    align-items: center;
  }

  .heading h1 {
    margin: 1rem 0;
    font-size: clamp(2.6rem, 6vw, 3.8rem);
  }

  .heading span {
    font-size: 1.25rem;
    line-height: 1.5;
    display: block;
    max-width: 34rem;
    text-wrap: pretty;
    opacity: 0.85;
  }

  .heading-left {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50vw;
  }

  .heading-right {
    text-align: left;
    padding: 1rem;
    width: 40vw;
    margin-left: -50px;
  }

  @media (max-width: 800px) {
    .heading {
      flex-direction: column;
    }

    .heading-left {
      width: 100%;
      justify-content: center;
      overflow: hidden;
    }
    .heading-right {
      width: auto;
      margin-left: 0;
    }
  }
</style>