---
const {title, titleClass, subtitle, backgroundColor, secondaryColor} = Astro.props;
---

<header class:list={["heading", "unmargin", { plain: !backgroundColor }]} style={`background-color: ${backgroundColor}`}>
  <div class="heading-left">
    <slot name="left"/>
  </div>
  <div class="heading-right">
    <h1 style={{color: secondaryColor}} class={titleClass || ""}>{title}</h1>
    <span style={{color: secondaryColor}}>{subtitle}</span>
    <slot name="right" />
  </div>
</header>

<style>
  .heading {
    /* sizing */
    margin-bottom: 2rem;
    min-height: 500px;

    /* extend the background behind the floating navbar */
    margin-top: calc(-1 * var(--nav-clearance));
    padding-top: var(--nav-clearance);

    /* nesting */
    display: flex;
    justify-content: center;
    flex-direction: row;
    align-items: center;
  }

  .heading h1 {
    margin: 1rem 0;
    font-size: clamp(2.5rem, 2vw + 1.5rem, 3.25rem);
  }

  /* soft accent wash for heroes without an explicit background color */
  .heading.plain {
    background: radial-gradient(ellipse 90% 70% at 50% 0%, #e9f0fd 0%, #ffffff00 70%);
  }

  .heading span {
    font-size: 1.2rem;
    line-height: 1.5;
    opacity: 0.85;
  }

  .heading-left {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50vw;
  }

  .heading-right {
    text-align: left;
    padding: 1rem;
    width: 40vw;
    margin-left: -50px;
  }

  @media (max-width: 800px) {
    .heading {
      flex-direction: column;
    }

    .heading-left {
      width: 100%;
      justify-content: center;
      overflow: hidden;
    }
    .heading-right {
      width: auto;
      margin-left: 0;
    }
  }
</style>