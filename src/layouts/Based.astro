---
// first party
import type { MarkdownLayoutProps } from 'astro';

// custom
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
// import TOC from '../components/TOC.astro';

type Frontmatter = MarkdownLayoutProps<{
  title: string;
	description: string;
  created: string;
	updated: string;
	tags?: string[];
}> & {
	backgroundColor?: string;
	secondaryColor?: string;
};

const { frontmatter, url, headings, backgroundColor, secondaryColor } = Astro.props as Frontmatter;

const addedTags = frontmatter.tags ? ", " + frontmatter.tags.join(", ") : "";

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/resume', label: 'Resume' },
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-P1RK1FBCJM"></script>
		<script async is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-P1RK1FBCJM');
		</script>

		<!-- general -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{frontmatter.title}{frontmatter.title == "Alex Gulko" ? "" : " : Alex Gulko"}</title>
		<meta name="description" content={frontmatter.description} />

		<!-- SSO -->
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="author" content="Alex Gulko" />
		<meta name="keywords" content={"Alex Gulko, Gulko, CS, OSU, research, personal, portfolio, blog, software, engineering, programming, web, development" + addedTags} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#2b65dd" />
		<meta name="application-name" content="Alex Gulko" />

		<!-- favicon -->
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Alex Gulko" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		
		<!-- rss -->
		<link
		rel="alternate"
		type="application/rss+xml"
		title="Alex Gulko"
		href={new URL("rss.xml", Astro.site)}
		/>

		<!-- Katex -->
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
			integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
			crossorigin="anonymous"
		/>
		<!-- <script
			defer
			src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"
			integrity="sha384-XjKyOOlGwcjNTAIQHIpgOno0Hl1YQqzUOEleOLALmuqehneUG+vnGctmUb0ZY0l8"
			crossorigin="anonymous"
		></script>
		<script
			defer
			src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
			integrity="sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05"
			crossorigin="anonymous"
			onload="renderMathInElement(document.body);"
		></script> -->


	
	</head>
	<body>
		<Navbar links={links}/>
		<main style={{
			backgroundColor: backgroundColor || "white",
			color: secondaryColor || "#1b1b1b",
		}}>
		<!-- <TOC headings={headings} /> -->
			<slot />
		</main>

		<Footer />
	</body>
</html>
<style is:global>
	@font-face {
		font-family: 'Lexend';
		src: url('/fonts/Lexend-Light.ttf') format('truetype');
		font-display: swap;
	}
	@font-face {
		font-family: 'Computer Modern';
		src: url('/fonts/computer-modern.ttf') format('truetype');
		font-display: swap;
	}
	@font-face {
		font-family: 'Space Mono';
		src: url('/fonts/SpaceMono-Regular.ttf') format('truetype');
		font-display: swap;
	}

	:root {
		--active-color: #2b65dd;
		--active-color-transparent: #2b66dd70;
		--general-font: 'Lexend', sans-serif;
		--serif-font: 'Computer Modern', serif;
		--mono-font: 'Space Mono', monospace;

		--pagefind-ui-font: var(--general-font);

		/* keeps a comfortable gutter on narrow screens */
		--content-margin: max(50vw - 50ch, 1.25rem);
		/* space reserved for the floating navbar */
		--nav-clearance: 4rem;
	}

	::backdrop {
    backdrop-filter: blur(4px);
  }
	html {
		font-family: var(--general-font);
		scroll-behavior: smooth;
		-webkit-font-smoothing: antialiased;
		text-rendering: optimizeLegibility;
	}
	body {
		margin: 0;
	}
	::selection {
		background-color: var(--active-color-transparent);
	}
	:focus-visible {
		outline: 2px solid var(--active-color);
		outline-offset: 2px;
		border-radius: 0.25rem;
	}
	main {
		/* margin: 2rem; */
		min-height: 100vh;
		padding: var(--nav-clearance) var(--content-margin) 2rem;
	}
	section > p:not(.nodeLabel > p) {
		font-size: 1.2rem;
		margin-bottom: 1rem;
		line-height: 1.5;
	}
	section {
		margin: 1rem 0;
		padding: 5px;
		/* max-width: 100ch; */
	}
	.unmargin {
		margin: 0 calc(var(--content-margin) * -1);
	}

	p > a,
	span > a {
		word-break: break-word;
		transition: 0.2s ease-in-out;
	}
	a {
		color: var(--active-color);
		text-decoration: none;
	}
	p > a:not(.pagefind-ui__result-link):hover,
	span > a:hover {
		text-decoration: none;
		color: white;
		background-color: var(--active-color);
		border-radius: 0.5rem;
		/* negative margin offsets the padding so surrounding text does not shift */
		padding: 0.3rem 0.3rem;
		margin: -0.3rem -0.3rem;
	}

	p > a:not(.pagefind-ui__result-link):active,
	span > a:active {
		box-shadow: #2b66dd6c 0px 0px 0px 0.5rem;
	}


	button, a.button {
		font-family: var(--general-font);
		background-color: none;
		border: none;
		cursor: pointer;
	}

	a.icon, button.icon{
		background-color: transparent;
		color: black;
		padding: 0.45rem;
		border-radius: 50%;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		transition: all 0.2s ease;
	}
	a.icon:hover, button.icon:hover {
		color: var(--active-color);
		background-color: #2b66dd1a;
		transform: translateY(-2px);
	}

	h1, h2, h3 {
		margin-top: 1rem;
		margin-bottom: 1rem;
	}
	h1 {
		font-size: clamp(2rem, 4vw + 1rem, 2.5rem);
		font-weight: 500;
		text-wrap: balance;
	}
	h2 {
		font-size: clamp(1.6rem, 3vw + 0.8rem, 2rem);
		font-weight: 500;
		text-wrap: balance;
	}
	h3 {
		font-size: 1.5rem;
		font-weight: 500;
		text-wrap: balance;
	}

	table, th, td {
		border: 1px solid #d0d0d0;
		border-collapse: collapse;
	}
	th {
		background-color: #f5f5f5;
	}
	th, td {
		padding: 0.3rem 0.6rem;
	}

	blockquote {
		margin: 1rem 0;
		padding: 1rem 1.25rem;
		border-left: solid 5px var(--active-color-transparent);
		background-color: #f5f8fe;
		border-radius: 0 0.75rem 0.75rem 0;
	}
	blockquote p {
		margin: 0;
	}

	code:not(pre code) {
		font-family: var(--mono-font);
		font-size: 0.9em;
		background-color: #f2f4f8;
		padding: 0.1em 0.4em;
		border-radius: 0.4em;
	}

	hr {
		border: none;
		border-top: 1px solid #e4e4e4;
		margin: 2.5rem 0;
	}

	.portrait {
		border-radius: 1.5rem;
		box-shadow: 0 18px 40px #0000002b;
	}

	.font-serif {
		font-family: var(--serif-font)
	}
	.font-sans {
		font-family: var(--general-font);
	}
	.font-mono {
		font-family: var(--mono-font);
	}

	.center {
		margin-left: auto;
		margin-right: auto;
		width: fit-content;
		align-items: center;

	}

	.horizontal {
		display: flex;
		flex-direction: row;
		gap: 1rem;
	}

	.language-math {
		font-family: var(--serif-font);
		font-size: 1.5rem;
	}

</style>
