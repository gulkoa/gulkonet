---
// first party
import type { MarkdownLayoutProps } from 'astro';

// custom
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
// import TOC from '../components/TOC.astro';

type Frontmatter = MarkdownLayoutProps<{
  title: string;
	description: string;
  created: string;
	updated: string;
	tags?: string[];
}> & {
	backgroundColor?: string;
	secondaryColor?: string;
};

const { frontmatter, url, headings, backgroundColor, secondaryColor } = Astro.props as Frontmatter;

const addedTags = frontmatter.tags ? ", " + frontmatter.tags.join(", ") : "";

const links = [
	{ href: '/', label: 'Home' },
	{ href: '/projects', label: 'Projects' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/resume', label: 'Resume' },
];
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<!-- Google tag (gtag.js) -->
		<script async is:inline src="https://www.googletagmanager.com/gtag/js?id=G-P1RK1FBCJM"></script>
		<script async is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());

			gtag('config', 'G-P1RK1FBCJM');
		</script>

		<!-- general -->
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<title>{frontmatter.title}{frontmatter.title == "Alex Gulko" ? "" : " : Alex Gulko"}</title>
		<meta name="description" content={frontmatter.description} />

		<!-- SSO -->
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="author" content="Alex Gulko" />
		<meta name="keywords" content={"Alex Gulko, Gulko, CS, OSU, research, personal, portfolio, blog, software, engineering, programming, web, development" + addedTags} />
		<meta name="robots" content="index, follow" />
		<meta name="theme-color" content="#2b65dd" />
		<meta name="application-name" content="Alex Gulko" />

		<!-- favicon -->
		<link rel="icon" type="image/png" href="/favicon/favicon-96x96.png" sizes="96x96" />
		<link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
		<link rel="shortcut icon" href="/favicon/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
		<meta name="apple-mobile-web-app-title" content="Alex Gulko" />
		<link rel="manifest" href="/favicon/site.webmanifest" />
		
		<!-- rss -->
		<link
		rel="alternate"
		type="application/rss+xml"
		title="Alex Gulko"
		href={new URL("rss.xml", Astro.site)}
		/>

		<!-- fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Lexend:wght@300;400;500;600;700&display=swap"
		/>

		<!-- Katex -->
		<link
			rel="stylesheet"
			href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
			integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV"
			crossorigin="anonymous"
		/>
		<!-- <script
			defer
			src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"
			integrity="sha384-XjKyOOlGwcjNTAIQHIpgOno0Hl1YQqzUOEleOLALmuqehneUG+vnGctmUb0ZY0l8"
			crossorigin="anonymous"
		></script>
		<script
			defer
			src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
			integrity="sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05"
			crossorigin="anonymous"
			onload="renderMathInElement(document.body);"
		></script> -->


	
	</head>
	<body>
		<Navbar links={links}/>
		<main style={{
			backgroundColor: backgroundColor || "transparent",
			color: secondaryColor || "inherit",
		}}>
		<!-- <TOC headings={headings} /> -->
			<slot />
		</main>

		<Footer />
	</body>
</html>
<style is:global>
	@font-face {
		font-family: 'Lexend Fallback';
		src: url('/fonts/Lexend-Light.ttf') format('truetype');
		font-display: swap;
	}
	@font-face {
		font-family: 'Computer Modern';
		src: url('/fonts/computer-modern.ttf') format('truetype');
		font-display: swap;
	}
	@font-face {
		font-family: 'Space Mono';
		src: url('/fonts/SpaceMono-Regular.ttf') format('truetype');
		font-display: swap;
	}

	:root {
		--bg: #faf8f3;
		--ink: #1d1e26;
		--muted: #5f616e;
		--line: #e6e2d7;
		--card: #ffffff;

		--active-color: #2b65dd;
		--active-color-transparent: #2b66dd70;
		--accent-soft: #e9effc;

		--general-font: 'Lexend', 'Lexend Fallback', sans-serif;
		--serif-font: 'Computer Modern', serif;
		--mono-font: 'Space Mono', monospace;

		--pagefind-ui-font: var(--general-font);

		--shadow-sm: 0 1px 2px rgba(29, 30, 38, 0.06), 0 2px 8px rgba(29, 30, 38, 0.04);
		--shadow-md: 0 2px 4px rgba(29, 30, 38, 0.06), 0 12px 32px rgba(29, 30, 38, 0.1);

		--content-margin: calc(max(50vw - 50ch, 1.25rem));
	}

	::backdrop {
		backdrop-filter: blur(4px);
		background-color: rgba(29, 30, 38, 0.25);
	}
	::selection {
		background-color: var(--active-color);
		color: white;
	}
	html {
		font-family: var(--general-font);
		scroll-behavior: smooth;
		scroll-padding-top: 5rem;
	}
	body {
		margin: 0;
		background-color: var(--bg);
		color: var(--ink);
	}
	main {
		min-height: 100vh;
		padding: 0 var(--content-margin);
	}
	/* clear the fixed navbar on pages that start with a plain heading */
	main > section:first-child > h1:first-child {
		padding-top: 5rem;
	}
	section > p:not(.nodeLabel > p) {
		font-size: 1.15rem;
		margin-bottom: 1rem;
		line-height: 1.65;
	}
	section {
		margin: 1rem 0;
		padding: 5px;
	}
	.unmargin {
		margin: 0 calc(var(--content-margin) * -1);
	}

	p > a,
	span > a {
		word-break: break-word;
		transition: 0.2s ease-in-out;
	}
	a {
		color: var(--active-color);
		text-decoration: none;
	}
	p > a:not(.pagefind-ui__result-link),
	span > a {
		text-decoration: underline;
		text-decoration-color: var(--active-color-transparent);
		text-decoration-thickness: 1.5px;
		text-underline-offset: 3px;
		border-radius: 0.4rem;
		/* pre-allocate the hover pill so the layout doesn't shift */
		padding: 0.15em 0.25em;
		margin: -0.15em -0.25em;
	}
	p > a:not(.pagefind-ui__result-link):hover,
	span > a:hover {
		text-decoration: none;
		color: white;
		background-color: var(--active-color);
	}

	p > a:not(.pagefind-ui__result-link):active,
	span > a:active {
		box-shadow: #2b66dd6c 0px 0px 0px 0.4rem;
	}

	:focus-visible {
		outline: 2px solid var(--active-color);
		outline-offset: 2px;
		border-radius: 0.25rem;
	}

	button, a.button {
		font-family: var(--general-font);
		background-color: none;
		border: none;
		cursor: pointer;
	}

	a.icon, button.icon {
		background-color: transparent;
		color: var(--ink);
		padding: 0;
		transition: color 0.2s ease, transform 0.2s ease;
	}
	a.icon:hover, button.icon:hover {
		color: var(--active-color);
		transform: translateY(-2px);
	}

	h1, h2, h3 {
		margin-top: 1rem;
		margin-bottom: 1rem;
		line-height: 1.15;
		text-wrap: balance;
	}
	h1 {
		font-size: clamp(2.4rem, 5vw, 3.2rem);
		font-weight: 600;
		letter-spacing: -0.02em;
	}
	h2 {
		font-size: 1.9rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}
	h3 {
		font-size: 1.4rem;
		font-weight: 500;
	}
	main > section > h2,
	main > h2 {
		margin-top: 3rem;
	}
	main > section > h2::after,
	main > h2::after {
		content: '';
		display: block;
		width: 2.5rem;
		height: 3px;
		margin-top: 0.5rem;
		border-radius: 2px;
		background-color: var(--active-color);
	}

	:not(pre) > code {
		font-family: var(--mono-font);
		font-size: 0.85em;
		background-color: var(--accent-soft);
		border-radius: 0.3rem;
		padding: 0.1em 0.35em;
	}

	table {
		border-collapse: collapse;
		box-shadow: var(--shadow-sm);
		border-radius: 0.5rem;
		overflow: hidden;
	}
	table, th, td {
		border: 1px solid var(--line);
	}
	th {
		background-color: var(--accent-soft);
		font-weight: 600;
	}
	th, td {
		padding: 0.4rem 0.8rem;
	}

	blockquote {
		margin: 1.5rem 0;
		padding: 1rem 1.25rem;
		border-left: solid 4px var(--active-color);
		border-radius: 0 0.75rem 0.75rem 0;
		background-color: var(--accent-soft);
	}
	blockquote p {
		margin: 0;
	}

	hr {
		border: none;
		border-top: 1px solid var(--line);
		margin: 2.5rem 0;
	}

	.font-serif {
		font-family: var(--serif-font)
	}
	.font-sans {
		font-family: var(--general-font);
	}
	.font-mono {
		font-family: var(--mono-font);
	}

	.center {
		margin-left: auto;
		margin-right: auto;
		width: fit-content;
		align-items: center;
	}

	.horizontal {
		display: flex;
		flex-direction: row;
		gap: 1rem;
	}

	figcaption {
		color: var(--muted);
		font-size: 0.95rem;
		margin-top: 0.5rem;
		text-align: center;
	}

	.hero-photo {
		border-radius: 28px;
		box-shadow: var(--shadow-md);
		rotate: -2deg;
		transition: rotate 0.3s ease;
	}
	.hero-photo:hover {
		rotate: 0deg;
	}

	.language-math {
		font-family: var(--serif-font);
		font-size: 1.5rem;
	}

</style>
